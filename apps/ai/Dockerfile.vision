FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libgl1 \
       libglib2.0-0 \
       libsm6 \
       libxext6 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-vision.txt .

RUN pip install --no-cache-dir -r requirements-vision.txt

# The model file is ignored by Git. Download it while building so a fresh clone
# can build the image without a separately shared local yolov8s.pt file.
RUN python -c "from ultralytics import YOLO; YOLO('yolov8s.pt')"

COPY server.py .
COPY detector.py .

EXPOSE 8000

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
