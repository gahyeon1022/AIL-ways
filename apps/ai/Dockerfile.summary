FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-summary.txt .

RUN pip install --no-cache-dir -r requirements-summary.txt

COPY summarizer_api.py .
COPY summarizer.py .
COPY weekly_summarizer.py .
COPY weekly_summarizer_api.py .

EXPOSE 8001

CMD ["uvicorn", "summarizer_api:app", "--host", "0.0.0.0", "--port", "8001"]