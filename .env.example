# Docker Compose environment variables
# Copy this file to .env and replace every placeholder before starting services.

OPENAI_API_KEY=replace-with-openai-api-key
JWT_PW=replace-with-a-random-secret-at-least-32-bytes-long
APP_PW=replace-with-gmail-app-password
KAKAO_PW=replace-with-kakao-rest-api-key
